# Variables de entorno del bot de Travian
# Copia este archivo como .env y rellena los valores reales.

# Criptografia (OBLIGATORIA)
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TRAVIAN_BOT_SECRET_KEY=

# Fuente de estadisticas: fixture (default, tests) o live (Chrome real, requiere POST /login)
OVERVIEW_SOURCE=live

# Opcionales:
# OVERVIEW_CACHE_TTL_SECONDS=60
# OVERVIEW_PAGE_TIMEOUT_SECONDS=30
