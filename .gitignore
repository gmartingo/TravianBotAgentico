# Entornos virtuales
.venv/
venv/
env/

# Perfiles de Chrome (datos sensibles y pesados)
profiles/
!profiles/.gitkeep
# Perfil del scraper kirilloid (separado de perfiles de juego)
profiles/scraper_kirilloid/

# Iconos PNG generados por el scraper (recursos de juego, no código)
assets/icons/*.png

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Bases de datos locales
*.db
*.sqlite
*.sqlite3

# Variables de entorno y secretos
.env

# IDEs y editores
.vscode/settings.json
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Node / frontend
frontend/node_modules/
frontend/dist/

# Logs
*.log
logs/

# Scripts de prueba manual (pueden contener credenciales reales)
test_login_manual.py

# Guía de agentes (documentación interna generada, no versionada)
documentacion/guia-agentes/

# pytest
.pytest_cache/
.coverage
htmlcov/

# Artefactos de Claude Code (runtime del agente, no código del proyecto)
.claude/agent-memory/
.claude/settings.json

# graphify — grafo de conocimiento generado (salida + caché, no versionar)
graphify-out/
