# Entornos virtuales
.venv/
venv/
env/

# Perfiles de Chrome (datos sensibles y pesados)
profiles/
!profiles/.gitkeep
# Perfil del scraper kirilloid (separado de perfiles de juego)
profiles/scraper_kirilloid/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Bases de datos locales
*.db
*.db-shm
*.db-wal
*.db.bak*
*.sqlite
*.sqlite3

# Variables de entorno y secretos
.env

# IDEs y editores
.vscode/settings.json
.idea/
*.swp
*.swo

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Node / frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# Logs
*.log
logs/

# Scripts de prueba manual (pueden contener credenciales reales)
test_login_manual.py

# Guía de agentes (documentación interna generada, no versionada)
documentacion/guia-agentes/

# pytest
.pytest_cache/
.coverage
htmlcov/

# Claude Code — el "cerebro" del workspace SÍ se versiona (ver bootstrap.sh / SETUP-WORKSPACE.md):
#   .claude/agent-memory/  -> memoria de los subagentes (analista, palantir, ...), viaja con el repo
#   .claude/claude-memory/ -> memoria de Claude (auto-memorias), enlazada por bootstrap
#   .claude/settings.json  -> permisos/acceptEdits (sin secretos), misma experiencia en cada PC
# Lo que NUNCA debe versionarse vive fuera (perfiles/, *.db, .env) — ver SETUP-WORKSPACE.md.
.claude/settings.local.json

# graphify — grafo de conocimiento generado (salida + caché, no versionar)
graphify-out/
.graphifyignore

# Metadatos de Obsidian (cliente local de documentación)
docs/.obsidian/
